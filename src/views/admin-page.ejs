<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — StayEase</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <style>
        :root {
            --primary-blue: #003580;
            --secondary-blue: #006ce4;
            --accent-yellow: #febb02;
            --light-bg: #f5f5f5;
            --text-main: #1a1a1a;
            --text-muted: #4d4d4d;
            --border-color: #e7e7e7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--light-bg);
            color: var(--text-main);
            min-height: 100vh;
        }

        .header {
            background-color: var(--primary-blue);
            padding: 16px 20px;
            color: #fff;
        }

        .navbar {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            text-decoration: none;
            color: #fff;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 14px;
        }

        .nav-right a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
        }

        .page {
            max-width: 1100px;
            margin: 32px auto 48px;
            padding: 0 20px;
        }

        .page-header {
            margin-bottom: 28px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-header p {
            font-size: 14px;
            color: var(--text-muted);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
        }

        .stat-card span {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .stat-card strong {
            display: block;
            font-size: 28px;
            margin-top: 6px;
            color: var(--primary-blue);
        }

        .section {
            margin-bottom: 40px;
        }

        .section h2 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .data-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .hotel-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            background: #e0e7ef;
            display: block;
        }

        .hotel-img-placeholder {
            width: 100%;
            height: 160px;
            background: #e0e7ef;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #bbb;
        }

        .card-body {
            padding: 16px 18px 12px;
            flex: 1;
        }

        .card-body h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .meta i {
            font-size: 16px;
        }

        .price {
            font-size: 16px;
            font-weight: 700;
            margin-top: 8px;
        }

        .price span {
            font-size: 12px;
            font-weight: 400;
            color: var(--text-muted);
        }

        .user-card-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--secondary-blue);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            flex-shrink: 0;
        }

        .btn-delete {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 12px;
            border: none;
            border-top: 1px solid var(--border-color);
            background: #fff;
            color: #dc3545;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-delete:hover {
            background: #dc3545;
            color: #fff;
        }

        .btn-delete i {
            font-size: 18px;
        }

        .empty {
            background: #fff;
            border: 1px dashed var(--border-color);
            border-radius: 8px;
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
        }

        .empty i {
            font-size: 40px;
            color: #ccc;
            display: block;
            margin-bottom: 8px;
        }

        @media (max-width: 640px) {
            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <header class="header">
        <nav class="navbar">
            <a href="/" class="logo">StayEase.com</a>
            <div class="nav-right">
                <span>Admin</span>
                <a href="/logout">Logout</a>
            </div>
        </nav>
    </header>

    <main class="page">
        <div class="page-header">
            <h1>Admin dashboard</h1>
            <p>View and remove hotels and users in the database.</p>
        </div>

        <div class="stats">
            <div class="stat-card">
                <span>Hotels</span>
                <strong><%= typeof hotels !== 'undefined' && hotels ? hotels.length : 0 %></strong>
            </div>
            <div class="stat-card">
                <span>Users</span>
                <strong><%= typeof users !== 'undefined' && users ? users.length : 0 %></strong>
            </div>
        </div>

        <section class="section">
            <h2>Hotels</h2>
            <% if (typeof hotels !== 'undefined' && hotels && hotels.length > 0) { %>
                <div class="card-grid">
                    <% hotels.forEach(hotel => { %>
                        <article class="data-card" data-hotel-id="<%= hotel._id %>">
                            <% if (hotel.photos && hotel.photos.length > 0) { %>
                                <img class="hotel-img" src="<%= hotel.photos[0] %>" alt="<%= hotel.hotelName %>">
                            <% } else { %>
                                <div class="hotel-img-placeholder">
                                    <i class="material-icons-outlined" style="font-size:48px;">apartment</i>
                                </div>
                            <% } %>
                            <div class="card-body">
                                <h3><%= hotel.hotelName %></h3>
                                <p class="meta">
                                    <i class="material-icons-outlined">place</i>
                                    <%= hotel.location || 'No location' %>
                                </p>
                                <p class="meta">Owner: <%= hotel.ownername || '—' %></p>
                                <p class="meta">Rooms: <%= hotel.totalRooms || 0 %></p>
                                <p class="price">₹<%= hotel.price %> <span>/ night</span></p>
                            </div>
                            <button type="button" class="btn-delete"
                                onclick="deleteHotel('<%= hotel._id %>')">
                                <i class="material-icons-outlined">delete</i>
                                Delete
                            </button>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty">
                    <i class="material-icons-outlined">apartment</i>
                    No hotels found.
                </div>
            <% } %>
        </section>

        <section class="section">
            <h2>Users</h2>
            <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                <div class="card-grid">
                    <% users.forEach(user => { %>
                        <article class="data-card" data-user-id="<%= user._id %>">
                            <div class="card-body">
                                <div class="user-card-top">
                                    <div class="avatar">
                                        <%= (user.name || 'U').charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <h3><%= user.name %></h3>
                                        <p class="meta"><%= user.email %></p>
                                    </div>
                                </div>
                                <p class="meta">User ID: <%= user.userid || '—' %></p>
                            </div>
                            <button type="button" class="btn-delete"
                                onclick="deleteUser('<%= user._id %>')">
                                <i class="material-icons-outlined">delete</i>
                                Delete
                            </button>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty">
                    <i class="material-icons-outlined">group</i>
                    No users found.
                </div>
            <% } %>
        </section>
    </main>

    <script>
        function deleteHotel(id) {
            if (!confirm('Delete this hotel? This cannot be undone.')) return;
            fetch('/admin/hotels/' + id, { method: 'DELETE' })
                .then(function (res) {
                    if (res.ok) window.location.reload();
                    else alert('Failed to delete hotel.');
                })
                .catch(function () {
                    alert('Something went wrong.');
                });
        }

        function deleteUser(id) {
            if (!confirm('Delete this user? This cannot be undone.')) return;
            fetch('/admin/users/' + id, { method: 'DELETE' })
                .then(function (res) {
                    if (res.ok) window.location.reload();
                    else alert('Failed to delete user.');
                })
                .catch(function () {
                    alert('Something went wrong.');
                });
        }
    </script>
</body>

</html>
