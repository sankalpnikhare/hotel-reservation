    <!-- Basic Date Picker Integration (Optional, using native date for simplicity if preferred) -->
    <!-- For now, I'll keep it simple with native inputs hidden behind the display -->
    <script>
        // Guest Dropdown Logic
        const guestField = document.getElementById('guest-field');
        const guestTrigger = document.getElementById('guest-trigger');
        const guestText = document.getElementById('guest-text');
        const params = new URLSearchParams(window.location.search);

        if (params.get('loginRequired')) {
            alert("Please log in first");
        }

        // Location Dropdown Logic
        const locationField = document.getElementById('location-field');
        const locationInput = document.getElementById('location-input');
        const locationDropdown = document.getElementById('location-dropdown');
        const locationItems = document.querySelectorAll('.location-item');

        locationInput.addEventListener('click', (e) => {
            e.stopPropagation();
            guestField.classList.remove('active');
            locationField.classList.add('active');
        });

        locationInput.addEventListener('focus', (e) => {
            e.stopPropagation();
            guestField.classList.remove('active');
            locationField.classList.add('active');
        });

        locationInput.addEventListener('input', () => {
            const query = locationInput.value.toLowerCase().trim();
            locationItems.forEach(item => {
                const value = item.getAttribute('data-value').toLowerCase();
                if (value.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });

        locationItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                locationInput.value = item.getAttribute('data-value');
                locationField.classList.remove('active');
            });
        });

        guestTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            locationField.classList.remove('active');
            guestField.classList.toggle('active');
        });

        document.addEventListener('click', () => {
            guestField.classList.remove('active');
            locationField.classList.remove('active');
            dateField.classList.remove('active');
        });

        document.querySelector('.guest-dropdown').addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Calendar Logic
        const dateField = document.getElementById('date-field');
        const dateTrigger = document.getElementById('date-field-trigger');
        const dateDisplayText = document.getElementById('date-display-text');
        const checkinHidden = document.getElementById('checkin-input-hidden');
        const checkoutHidden = document.getElementById('checkout-input-hidden');
        const calendarDropdown = document.getElementById('calendar-dropdown');

        const today = new Date();
        today.setHours(0,0,0,0);

        let checkInDate = null;
        let checkOutDate = null;
        let hoveredDate = null;

        let displayLeftMonth = new Date(2026, 6, 1); // July 2026

        function setupCalendar() {
            // Set inputs initial values
            checkinHidden.value = '';
            checkoutHidden.value = '';
            updateDateDisplay();

            // Setup tab listeners
            const calendarTabs = document.querySelectorAll('.calendar-tab');
            calendarTabs.forEach(tab => {
                tab.addEventListener('click', (e) => {
                    e.stopPropagation();
                    calendarTabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                });
            });

            // Prevent dropdown clicks from propagating
            calendarDropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });

            // Date field trigger click
            dateTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                locationField.classList.remove('active');
                guestField.classList.remove('active');
                dateField.classList.toggle('active');
                renderCalendar();
            });

            // Month navigation arrow click listeners
            document.getElementById('prev-month-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                displayLeftMonth.setMonth(displayLeftMonth.getMonth() - 1);
                renderCalendar();
            });

            document.getElementById('next-month-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                displayLeftMonth.setMonth(displayLeftMonth.getMonth() + 1);
                renderCalendar();
            });

            // Clear highlights when mouse leaves the calendar area
            document.querySelector('.months-container').addEventListener('mouseleave', () => {
                if (checkInDate && !checkOutDate) {
                    hoveredDate = null;
                    updateRangeHighlights();
                }
            });

            renderCalendar();
        }

        function renderCalendar() {
            const leftMonth = displayLeftMonth;
            const rightMonth = new Date(leftMonth.getFullYear(), leftMonth.getMonth() + 1, 1);

            renderMonth(leftMonth, 'month-1-title', 'month-1-days');
            renderMonth(rightMonth, 'month-2-title', 'month-2-days');
            updateNavButtons();
        }

        function updateRangeHighlights() {
            const cells = document.querySelectorAll('.day-cell[data-time]');
            cells.forEach(cell => {
                const cellTime = parseInt(cell.dataset.time);
                if (checkInDate && !checkOutDate && hoveredDate) {
                    if (cellTime > checkInDate.getTime() && cellTime <= hoveredDate.getTime()) {
                        cell.classList.add('in-range');
                    } else {
                        cell.classList.remove('in-range');
                    }
                } else if (checkInDate && checkOutDate) {
                    if (cellTime > checkInDate.getTime() && cellTime < checkOutDate.getTime()) {
                        cell.classList.add('in-range');
                    } else {
                        cell.classList.remove('in-range');
                    }
                } else {
                    cell.classList.remove('in-range');
                }
            });
        }

        function renderMonth(monthDate, titleId, gridId) {
            const year = monthDate.getFullYear();
            const month = monthDate.getMonth();

            const titleEl = document.getElementById(titleId);
            const gridEl = document.getElementById(gridId);

            const monthName = monthDate.toLocaleString('default', { month: 'long' });
            titleEl.textContent = `${monthName} ${year}`;

            gridEl.innerHTML = '';

            const firstDay = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();

            // Empty cells before the first day
            for (let i = 0; i < firstDay; i++) {
                const cell = document.createElement('div');
                cell.className = 'day-cell empty';
                gridEl.appendChild(cell);
            }

            // Days of the month
            for (let day = 1; day <= totalDays; day++) {
                const date = new Date(year, month, day);
                const cell = document.createElement('div');
                cell.className = 'day-cell';
                cell.textContent = day;

                const time = date.getTime();
                const todayTime = today.getTime();
                cell.dataset.time = time;

                if (time < todayTime) {
                    cell.classList.add('disabled');
                } else {
                    if (checkInDate && time === checkInDate.getTime()) {
                        cell.classList.add('start-date');
                    } else if (checkOutDate && time === checkOutDate.getTime()) {
                        cell.classList.add('end-date');
                    } else if (checkInDate && checkOutDate && time > checkInDate.getTime() && time < checkOutDate.getTime()) {
                        cell.classList.add('in-range');
                    } else if (checkInDate && !checkOutDate && hoveredDate && time > checkInDate.getTime() && time <= hoveredDate.getTime()) {
                        cell.classList.add('in-range');
                    }

                    cell.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (!checkInDate || checkOutDate) {
                            checkInDate = date;
                            checkOutDate = null;
                            updateRangeHighlights();
                            updateDateDisplay();
                            renderCalendar();
                        } else if (checkInDate && !checkOutDate) {
                            if (time < checkInDate.getTime()) {
                                checkInDate = date;
                                updateRangeHighlights();
                                updateDateDisplay();
                                renderCalendar();
                            } else {
                                checkOutDate = date;
                                checkinHidden.value = formatDateForInput(checkInDate);
                                checkoutHidden.value = formatDateForInput(checkOutDate);
                                updateDateDisplay();
                                renderCalendar();
                                dateField.classList.remove('active');
                            }
                        }
                    });

                    cell.addEventListener('mouseenter', () => {
                        if (checkInDate && !checkOutDate) {
                            hoveredDate = date;
                            updateRangeHighlights();
                        }
                    });
                }

                gridEl.appendChild(cell);
            }
        }

        function updateNavButtons() {
            const prevBtn = document.getElementById('prev-month-btn');
            const currentMonthFirst = new Date(today.getFullYear(), today.getMonth(), 1);
            if (displayLeftMonth.getTime() <= currentMonthFirst.getTime()) {
                prevBtn.style.visibility = 'hidden';
            } else {
                prevBtn.style.visibility = 'visible';
            }
        }

        function updateDateDisplay() {
            if (checkInDate && checkOutDate) {
                dateDisplayText.textContent = `${formatShortDate(checkInDate)} — ${formatShortDate(checkOutDate)}`;
            } else if (checkInDate) {
                dateDisplayText.textContent = `${formatShortDate(checkInDate)} — Check-out date`;
            } else {
                dateDisplayText.textContent = 'Select check-in and check-out dates';
            }
        }

        function formatShortDate(date) {
            const options = { weekday: 'short', month: 'short', day: 'numeric' };
            return date.toLocaleDateString('en-US', options);
        }

        function formatDateForInput(date) {
            if (!date) return '';
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }

        function setupStepper(id, min, max, onChange) {
            const display = document.getElementById(id + '-count');
            const input = document.getElementById(id + '-input');
            const minus = document.getElementById(id + '-minus');
            const plus = document.getElementById(id + '-plus');

            display.textContent = input.value; // Sync UI count with input value

            minus.addEventListener('click', () => {
                let val = parseInt(display.textContent);
                if (val > min) {
                    val--;
                    display.textContent = val;
                    input.value = val;
                    onChange();
                }
            });

            plus.addEventListener('click', () => {
                let val = parseInt(display.textContent);
                if (val < max) {
                    val++;
                    display.textContent = val;
                    input.value = val;
                    onChange();
                }
            });
        }

        function updateGuestText() {
            const adults = document.getElementById('adults-count').textContent;
            const rooms = document.getElementById('rooms-count').textContent;
            guestText.textContent = `${adults} adults · ${rooms} room${rooms > 1 ? 's' : ''}`;
        }

        setupStepper('adults', 1, 10, updateGuestText);
        setupStepper('rooms', 1, 10, updateGuestText);

        setupCalendar();
    </script>
</body>

</html>